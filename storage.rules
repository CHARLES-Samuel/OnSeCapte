rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /groups/{groupId}/photo.jpg {
      // Seul le créateur du groupe pourrait uploader, mais on n'a pas accès à Firestore depuis Storage facilement sans custom claims.
      // On s'assure juste que l'utilisateur est authentifié et que le fichier fait moins de 2 Mo.
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Modèle de Données Présumé (Assumed Data Model)
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (identique à request.auth.uid)
    // Champs:
    //   - displayName: string (requis, 1..50 caractères)
    //   - email: string (optionnel, <= 100 caractères)
    //   - photoURL: string (optionnel, <= 1000 caractères ou null)
    //
    // Collection: inviteCodes
    // Document ID: {code} (code d'invitation de 8 caractères en majuscules)
    // Champs:
    //   - groupId: string (requis, ID du groupe cible)
    //   - createdBy: string (requis, UID de l'auteur)
    //   - createdAt: timestamp (optionnel)
    //
    // Collection: groups
    // Document ID: {groupId}
    // Champs:
    //   - name: string (requis, 1..60 caractères)
    //   - description: string (requis/optionnel, <= 2000 caractères)
    //   - createdBy: string (requis, UID du propriétaire initial)
    //   - createdAt: timestamp (requis, immuable)
    //   - members: list de strings (requis, UIDs, max 100 membres)
    //   - inviteCode: string (requis, 8 caractères, immuable)
    //   - bannedMemberIds: list de strings (optionnel)
    //   - photoUrl: string (optionnel)
    //   - bannerUrl: string (optionnel)
    //   - joinCodeAttempt: string (optionnel, utilisé lors du check d'adhésion)
    //
    // Sous-collection: groups/{groupId}/plannings/{planningUserId}
    // Document ID: {planningUserId} (UID du membre)
    // Champs:
    //   - updatedAt: timestamp (requis)
    //   - dates: map (requis, clé: date string, valeur: statut disponibilité)
    //
    // Collection: events
    // Document ID: {eventId}
    // Champs:
    //   - groupId: string (requis, immuable)
    //   - title: string (requis, 1..100 caractères)
    //   - description: string (optionnel, <= 2000 caractères)
    //   - category: string (optionnel, <= 50 caractères)
    //   - price: number (optionnel, >= 0)
    //   - createdBy: string (requis, immuable)
    //   - createdByName: string (optionnel)
    //   - createdAt: timestamp (requis, immuable)
    //   - state: string (requis, 'sondage' | 'planifie' | 'passe')
    //   - dateMode: string (optionnel, 'poll' | 'fixed' | 'range' | 'any')
    //   - startDate: string (optionnel)
    //   - endDate: string (optionnel)
    //   - finalDate: string (optionnel)
    //   - finalTimeSlot: string (optionnel)
    //   - location: string (optionnel, <= 200 caractères)
    //   - link: string (optionnel, <= 500 caractères)
    //   - participations: map de strings (userId -> 'participating' | 'declined' | 'maybe')
    // ===============================================================

    // ===============================================================
    // Fonctions d'aide (Helper Functions)
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDocOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
      );
    }

    function isGroupOwner(groupId) {
      return isAuthenticated() && (
        request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
      );
    }

    // ===============================================================
    // 1. Profils utilisateurs
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create, update: if isDocOwner(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 100))
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL == null || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 1000));

      allow delete: if isDocOwner(userId);
    }

    // ===============================================================
    // 2. Registre des Codes d'Invitation (Sécurité Anti-Énumération)
    // ===============================================================
    match /inviteCodes/{code} {
      // Consultation directe uniquement (get O(1)).
      // INTERDICTION FORMELLE DE LISTER la collection (impossible de scanner ou moissonner les codes)
      allow get: if isAuthenticated();
      allow list: if false;

      // Création lors de la création d'un groupe
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId is string
        && code is string && code.size() == 8;

      // Suppression par le créateur ou le propriétaire du groupe
      allow delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid
        || isGroupOwner(resource.data.groupId)
      );

      // Codes immuables
      allow update: if false;
    }

    // ===============================================================
    // 3. Groupes (Cloisonnement strict & Validation cryptographique du code)
    // ===============================================================
    match /groups/{groupId} {
      function isOwner() {
        return request.auth.uid == resource.data.createdBy;
      }
      function isMember() {
        return request.auth.uid in resource.data.members;
      }
      function isBanned() {
        return ('bannedMemberIds' in resource.data) && (request.auth.uid in resource.data.bannedMemberIds);
      }

      function isValidGroupCreate() {
        return request.auth.uid == request.resource.data.createdBy
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() == 8
          && request.resource.data.members is list
          && request.resource.data.members == [request.auth.uid]
          && (!('bannedMemberIds' in request.resource.data) || request.resource.data.bannedMemberIds == []);
      }

      function isValidOwnerUpdate() {
        return isOwner()
          // L'ancien propriétaire peut transférer le groupe à un membre existant
          && (request.resource.data.createdBy == resource.data.createdBy || request.resource.data.createdBy in resource.data.members)
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 2000
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 100;
      }

      function isValidJoinUpdate() {
        return !isBanned()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCodeAttempt'])
          // La tentative doit obligatoirement fournir le code secret du groupe
          && ('joinCodeAttempt' in request.resource.data)
          && request.resource.data.joinCodeAttempt == resource.data.inviteCode
          // L'utilisateur ne peut s'ajouter que lui-même
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members;
      }

      function isValidLeaveUpdate() {
        return isMember()
          && !isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          // L'utilisateur ne peut que se retirer lui-même
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && !(request.auth.uid in request.resource.data.members);
      }

      // Lecture : STRICTEMENT RÉSERVÉE aux membres et au créateur
      // Un utilisateur extérieur ne peut ni lister, ni inspecter les groupes privés
      allow list: if isAuthenticated() && (request.auth.uid in resource.data.members);
      allow get: if isAuthenticated() && (
        request.auth.uid in resource.data.members || request.auth.uid == resource.data.createdBy
      );

      allow create: if isAuthenticated() && isValidGroupCreate();
      allow update: if isAuthenticated() && (
        isValidOwnerUpdate() || isValidJoinUpdate() || isValidLeaveUpdate()
      );
      allow delete: if isAuthenticated() && isOwner();
    }

    // ===============================================================
    // 4. Plannings de groupe (Disponibilités partagées)
    // ===============================================================
    match /groups/{groupId}/plannings/{planningUserId} {
      // Seuls les membres du groupe peuvent consulter les disponibilités
      allow read: if isAuthenticated() && (isGroupMember(groupId) || isGroupOwner(groupId));
      // Seul le membre concerné peut modifier son propre planning
      allow write: if isAuthenticated() && request.auth.uid == planningUserId && isGroupMember(groupId);
      // Suppression par le membre lui-même ou le gérant
      allow delete: if isAuthenticated() && (request.auth.uid == planningUserId || isGroupOwner(groupId));
    }

    // ===============================================================
    // 5. Événements (Contrôle d'accès granulaire aux votes et détails)
    // ===============================================================
    match /events/{eventId} {
      function isValidEventCreate() {
        return request.resource.data.createdBy == request.auth.uid
          && isGroupMember(request.resource.data.groupId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 2000))
          && request.resource.data.state in ['sondage', 'planifie']
          && (!('dateMode' in request.resource.data) || request.resource.data.dateMode in ['poll', 'fixed', 'range', 'any'])
          && request.resource.data.participations is map
          && request.resource.data.participations.keys().hasOnly([request.auth.uid]);
      }

      // Seul le créateur de l'événement ou le gérant du groupe peut modifier les détails
      function isValidEventDetailUpdate() {
        return (request.auth.uid == resource.data.createdBy || isGroupOwner(resource.data.groupId))
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100;
      }

      // Un membre ordinaire peut UNIQUEMENT modifier sa PROPRE participation
      function isValidParticipationUpdate() {
        return isGroupMember(resource.data.groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participations'])
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.title == resource.data.title
          && (
            (request.auth.uid in request.resource.data.participations)
            && request.resource.data.participations[request.auth.uid] in ['participating', 'declined', 'maybe']
          );
      }

      // Nettoyage lors de la sortie d'un membre
      function isLeaveGroupCleanup() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participations'])
          && !(request.auth.uid in request.resource.data.participations);
      }

      // Lecture : STRICTEMENT RÉSERVÉE aux membres du groupe parent
      allow read: if isAuthenticated() && (
        isGroupMember(resource.data.groupId) || isGroupOwner(resource.data.groupId)
      );

      allow create: if isAuthenticated() && isValidEventCreate();
      allow update: if isAuthenticated() && (
        isValidEventDetailUpdate() || isValidParticipationUpdate() || isLeaveGroupCleanup()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.createdBy || isGroupOwner(resource.data.groupId)
      );
    }
  }
}
